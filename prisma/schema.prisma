// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Existing Models (for backward compatibility)
// ============================================================================

model Total {
  // Singleton row ID (always "current")
  id     String @id @default("current")
  // Lotus blocks synced
  blocks Int    @default(1)
  // Lotus supply in Satoshis; first block yielded 260,000,000
  supply BigInt @default(260000000)
  // Total burned Lotus supply in Satoshis (OP_RETURN + burned fees)
  burned BigInt @default(0)
  // Total non-coinbase transactions
  txs    Int    @default(0)
}

model Block {
  // block hash
  id         String @id
  // block height
  height     Int
  // block timestamp
  timestamp  BigInt
  // block difficulty
  difficulty BigInt
  // block miner address
  minedBy    String
  // total subsidy
  subsidy    BigInt
  // total burned
  burned     BigInt
  // total transactions, including coinbase
  numTxs     Int    @default(1)
}

// ============================================================================
// TimescaleDB Time-Series Models
// These tables are converted to hypertables after creation via SQL migration.
// ============================================================================

/// Block-level metrics for time-series analysis
/// Converted to TimescaleDB hypertable with 7-day chunks
model BlockMetrics {
  /// Block timestamp (used as partition column for hypertable)
  time       DateTime @db.Timestamptz
  /// Block height (unique identifier within the chain)
  height     Int
  /// Block hash
  hash       String
  /// Block difficulty (used for difficulty charts)
  difficulty Decimal  @db.Decimal(30, 0)
  /// Block subsidy in satoshis (used for inflation charts)
  subsidy    BigInt
  /// Total burned in satoshis (OP_RETURN outputs + burned fees)
  burned     BigInt
  /// Number of transactions in the block (including coinbase)
  numTxs     Int      @default(1)
  /// Miner address (for mining distribution charts)
  minedBy    String

  // Composite primary key for TimescaleDB compatibility
  // Note: Hypertables require the partition column in the primary key
  @@id([time, height])
  @@index([time(sort: Desc)])
  @@index([height(sort: Desc)])
}

/// Checkpoint for tracking indexer sync state
/// Stores the latest synced block for reconciliation on startup
model Checkpoint {
  /// Singleton ID (always "current")
  id        String   @id @default("current")
  /// Block hash of the checkpoint
  hash      String
  /// Block height of the checkpoint
  height    Int
  /// Block timestamp of the checkpoint
  timestamp BigInt
  /// Previous block hash (for reorg detection)
  prevHash  String?
  /// Last updated timestamp
  updatedAt DateTime @default(now()) @updatedAt
}
